{
  "name": "Spark Codespaces Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    8080,
    8081,
    8082,
    4040
  ],
  "portsAttributes": {
    "4040": {
      "label": "Driver UI 실행 중에만 사용",
      "onAutoForward": "silent"
    },
    "8080": {
      "label": "Spark Master",
      "onAutoForward": "silent"
    },
    "8081": {
      "label": "Worker 1",
      "onAutoForward": "silent"
    },
    "8082": {
      "label": "Worker 2",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash scripts/prepare.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "files.eol": "\n"
      }
    }
  },
  "remoteUser": "vscode"
}
